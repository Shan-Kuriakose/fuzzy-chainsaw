# Copy to .env for local development; .env is gitignored and never committed.
# Secret values in staging come from the deployment environment, not from files.
APP_NAME=fuzzy-chain-saw
ENVIRONMENT=local

# Dataset configuration storage (PostgreSQL service of docker-compose).
# Choose a password; it never leaves this file or the deployment environment.
POSTGRES_PASSWORD=change-me-locally
DATABASE_URL=postgresql+psycopg://fuzzy_chain_saw:change-me-locally@db/fuzzy_chain_saw
